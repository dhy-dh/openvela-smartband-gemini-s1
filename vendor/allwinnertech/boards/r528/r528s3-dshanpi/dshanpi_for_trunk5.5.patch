+#ifdef CONFIG_INPUT_FT5X06
+
+#define FT5X06_I2C_ADDRESS          (0x70 >> 1)
+#define FT5X06_FREQUENCY 400000
+
+struct ft5x06_isr_data {
+  int irq;
+  xcpt_t isr;
+  void * arg;
+};
+
+static struct ft5x06_isr_data *g_isr_data;
+
+static hal_irqreturn_t ft5x06_gpio_isr (void *data)
+{
+  struct ft5x06_isr_data *isr_data = data;
+  isr_data->isr(isr_data->irq, NULL, isr_data->arg);
+  return HAL_IRQ_OK;
+}
+static int r528_ft5x06_attach(const struct ft5x06_config_s *config,
+                               xcpt_t isr, void *arg)
+{
+  int ret;
+
+  g_isr_data->isr = isr;
+  g_isr_data->arg = arg;
+
+  ret = hal_gpio_irq_request(g_isr_data->irq, ft5x06_gpio_isr, IRQ_TYPE_EDGE_FALLING, g_isr_data);  
+  //iinfo("%s %s %d, ret = %d\n", __FILE__, __FUNCTION__, __LINE__, ret);
+  return ret;
+}
+static void r528_ft5x06_enable(const struct ft5x06_config_s *config,
+                                bool enable)
+{
+  //iinfo("%s %s %d, enable = %d\n", __FILE__, __FUNCTION__, __LINE__, enable);
+  if (enable)
+    {
+      if (g_isr_data)
+        hal_gpio_irq_enable(g_isr_data->irq);
+    }
+  else
+    {
+      if (g_isr_data)
+        hal_gpio_irq_disable(g_isr_data->irq);
+      
+    }
+}
+
+static void r528_ft5x06_clear(const struct ft5x06_config_s *config)
+{
+  
+}
+
+static void r528_ft5x06_wakeup(const struct ft5x06_config_s *config)
+{
+  /* We do not have access to the WAKE pin in the implementation */
+}
+
+static void r528_ft5x06_nreset(const struct ft5x06_config_s *config,
+                                bool nstate)
+{  
+}
+
+
+static const struct ft5x06_config_s g_ft5x06_config =
+{
+  .address   = FT5X06_I2C_ADDRESS,
+  .frequency = FT5X06_FREQUENCY,
+#ifndef CONFIG_FT5X06_POLLMODE
+  .attach    = r528_ft5x06_attach,
+  .enable    = r528_ft5x06_enable,
+  .clear     = r528_ft5x06_clear,
+#endif
+  .wakeup    = r528_ft5x06_wakeup,
+  .nreset    = r528_ft5x06_nreset
+};
+int r528_ft5x06_register(struct i2c_master_s *i2c_bus)
+{
+  struct ft5x06_isr_data *data = malloc(sizeof(struct ft5x06_isr_data));
+  uint32_t irq;
+
+  // reset pin
+  hal_gpio_pinmux_set_function(GPIOE(0), GPIO_MUXSEL_OUT);
+  hal_gpio_set_pull(GPIOE(0), GPIO_PULL_UP);
+  hal_gpio_set_data(GPIOE(0), 1);
+
+  hal_gpio_set_pull(GPIOE(1), GPIO_PULL_UP);
+  hal_gpio_to_irq(GPIOE(1), &irq);
+
+  data->irq = irq;  
+
+  g_isr_data = data;
+
+  // /dev/input0
+  return ft5x06_register(i2c_bus, &g_ft5x06_config, 0);
+}
+#endif
