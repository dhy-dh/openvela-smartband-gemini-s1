+static void lcd_lock(void)
+{
+  struct spi_dev_s *spi = g_spi_lcd_fb->spi;
+  SPI_LOCK(spi, true);
+  SPI_SETMODE(spi, SPIDEV_MODE0);
+  SPI_SETBITS(spi, 8);
+  SPI_HWFEATURES(spi, 0);
+  SPI_SETFREQUENCY(spi, 8000000);
+}
+
+static void lcd_unlock(void)
+{
+  struct spi_dev_s *spi = g_spi_lcd_fb->spi;
+  SPI_LOCK(spi, false);
+}
