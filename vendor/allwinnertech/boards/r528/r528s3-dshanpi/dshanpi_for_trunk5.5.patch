+ * 修改日期：      版本号     修改人       修改内容
+ * -----------------------------------------------
+ * 2024/02/01        V1.0     韦东山       创建
+ ***********************************************************************/
+int LCD_WriteDatas(uint8_t *datas, uint32_t count)
+{
+    //HAL_GPIO_WritePin(GPIOD,RS_Pin,GPIO_PIN_SET);  /* 由调用者设置RS引脚 */
+    return SPI_WriteDatas(datas, count);
+}
