	position: absolute;
	top: 0;
	left: 0;
	bottom: 0;
	right: 0;
	padding-top: 90px;
	background-image: url(../../common/mask.png); 
} **/

.result-wrap {
	position: relative;
	padding-top: 60px;
}

.item-center {
	align-items: center;
}

.max-num {
	padding-top: 20px;
	flex-direction: column;
	height: 70px;
}

.max-power {
	width: 100%;
	flex-direction: column;
	margin-top: 20px;
	font-size: 36px;
}

.bold {
	font-size: 36px;
}

@media (shape: pill-shaped) {
	.bold {
		font-size: 24px;
	}
}

.again-btn {
	margin-top: 26px;
	width: 100%;
	flex-direction: column;
}

.res-tag {
	position: absolute;
	right: 25px;
	top: 28px;
}

