<script>
import device from "@system.device";
import brightness from "@system.brightness";
import sensor from "@system.sensor";
global.formatNumber = function (number) {
	if (number) {
		return Math.round(number * 10) / 10;
	}
	return number;
};
global.getDisplayNumber = function (val) {
	return linearMap(val, 10, 180, 3, 50);
	function linearMap(value, inputMin, inputMax, outputMin, outputMax) {
		// 确保输入值在输入范围内
		let val = Math.min(Math.max(value, inputMin), inputMax);
		// 计算映射后的值
		const mappedValue =
			((val - inputMin) * (outputMax - outputMin)) / (inputMax - inputMin) +
			outputMin;
		// 确保映射后的值在输出范围内
		return Math.min(Math.max(mappedValue, outputMin), outputMax);
	}
};
global.deviceInfo = {};
export default {
	onCreate() {
		console.log("app created");
		device.getInfo({
			success: function (res) {
				global.deviceInfo = res;
				console.log(res);
			},
		});
		//常亮的逻辑迁移到loading中
		// brightness.setKeepScreenOn({
		// 	keepScreenOn: true,
		// 	success: function () {
		// 		console.log("keepScreenOn true");
		// 	},
		// 	fail: function (data, code) {
		// 		console.log(`handling fail, code = ${code}`);;
		// 	},
		// });
	},
	onDestroy() {
		console.log("app destroyed");
		// setTimeout((_) => {
		brightness.setKeepScreenOn({
			keepScreenOn: false,
			success: function () {
				console.log("keepScreenOn false success");
			},
			fail: function (data, code) {
				console.log(`handling fail, code = ${code}`);
			},
		});
		// }, 100);
	},
	onHide() {
		console.log("result hide-------------->");
		sensor.unsubscribeAccelerometer();
	},
};
</script>
