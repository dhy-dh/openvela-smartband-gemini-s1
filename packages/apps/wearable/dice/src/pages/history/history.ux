  width: 100%;
  text-align: center;
  margin-bottom: 10px;
}
.scroll-area {
  flex: 1;
  flex-direction: column;
}

text {
  color: #000;
  font-size: 26px;
}
.item {
  height: 50px;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}
.date {
  flex: 1;
}
@media (shape: circle){ 
  .page {
    padding-bottom: 35px;
  }
  .history {
    align-items: center;
  }
  .scroll-area {
    width: 80%;
  }
}
@media (width: 212) {
  .history {
    padding: 20px 15px 30px;
  }
  .item {
    height: 70px;
    align-items: flex-start;
