<template>
  <div class="page">
    <text if="{{ history && history.length === 0 }}" class="label">暂无记录</text>
    <div if="{{ history && history.length !== 0 }}" class="history">
      <text class="label">历史记录</text>
      <scroll scroll-y="{{true}}" class="scroll-area">
        <div for="{{history}}" class="item">
          <text class="date">
            <span>{{ $item.time.slice(0,11) }}</span>
            <span>{{ $item.time.slice(11,19) }}</span>
          </text>
          <text class="point">{{ $item.result }}点</text>
        </div>
      </scroll>
    </div>
  </div>
</template>

<script>
  export default {
    private: {
      list: '',
      history: []
    },
    onInit() {
      this.history = this.list ? JSON.parse(this.list) : []
    }
  }
</script>

