menu "quickapps utils"

config QUICKAPP_AIOTJSC
	bool "aiotjsc compiler"
	default y
	depends on USE_QUICKJS
	---help---
	quickapp aiotjsc compiler used to compile js code

if QUICKAPP_AIOTJSC
config QUICKAPP_SLEEP_PERCENT_FOR_COMPILE_JS_FILE
	int "js file compile sleep percent"
	default -1
	---help---
	After each compilation of JS files, a sleep function will be called to pause execution for a
	specified percentage of time. The longer the compilation takes, the longer the sleep duration,
	preventing the system from becoming too busy due to large-scale JS file compilation during
	application installation in automated testing scenarios

endif

endmenu #"quickapps utils"

