menu "quick application"

config QUICKAPP
	bool "Enable quick application"
	depends on LIBUV && PROTOBUF_C
	depends on (INTERPRETERS_QUICKJS || INTERPRETERS_WAMR)
	depends on GRAPHICS_LVGL && UIKIT && LIBUV_EXTENSION && UIKIT_FONT_MANAGER && LIB_YOGA && LV_USE_LIBPNG && LV_USE_NUTTX_LIBUV
	depends on UTILS_CURL # for image cache manager
	depends on LIB_PNG
	depends on FEATURE_FRAMEWORK
	depends on LIBASH
	select LIBC_PRINT_EXTENSION
	default n
	---help---
		This option enables quick app support


if QUICKAPP

choice
	prompt "quickapp runtime engine"
	default USE_QUICKJS
	---help---
		quickjs engine need INTERPRETERS_QUICKJS.
		wasm engine need INTERPRETERS_WAMR.

config USE_QUICKJS
	bool "quickjs engine"
	depends on INTERPRETERS_QUICKJS
	---help---
		The quickjs engine

endchoice

config QUICKAPP_VAPP
	bool "vapp"
	default n
	depends on GRAPHICS_LVGL && LIB_FREETYPE
	---help---
	the standard program to run rpk directly, used for test and some production such as 86v1
	it's the simplist mode for use quickapp.

config QUICKAPP_VAPP_XMS
	bool "vappxms"
	default n
	depends on GRAPHICS_LVGL && LIB_FREETYPE && SYSTEM_SERVER
	---help---
	integrate with xms service, only supported when xms is enabled

config QUICKAPP_PROPRIETARY
	bool "proprietary library mode"
	default y
	depends on GRAPHICS_LVGL && LIB_FREETYPE
	---help---
	proprietary library mode, requires proprietary/ directory

menu "quickapp production configurations"
config QUICKAPP_PRODUCT_PANEL
	bool "panel features"
	default n
	depends on (USE_QUICKJS)
	---help---
	enable panel features for 86v1... etc

config QUICKAPP_PRODUCT_SMARTSPEAKER
	bool "smartspeaker features"
	default n
	depends on (USE_QUICKJS)
	---help---
	enable smartspeaker features for x4b... etc


endmenu # "quickapp production configurations"

