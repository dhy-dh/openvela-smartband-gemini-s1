	string "Path of quick application data"
	default "/data"
	---help---
		The path where quick application data are stored. eg:
		Note: There can be no '/' at the end of the string.

config APP_INSTALL_PATH
	string "Path of quick application hap link"
	default HAP_APP_PATH
	---help---
		The path where quick application are stored. eg:
		${HAP_APP_PATH}  , hap:///${HAP_APP_PATH}/app/xxxxx
		Note: There can be no '/' at the end of the string.

