ifneq ($(CONFIG_QUICKAPP),)
CONFIGURED_APPS += $(APPDIR)/frameworks/runtimes/quickapp
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/quickapp/include
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/quickapp/src/jse/modules/system
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/quickapp/src/jse/quickjs
CXXFLAGS += ${INCDIR_PREFIX}$(APPDIR)/frameworks/runtimes/quickapp/src/jse
-include $(APPDIR)/frameworks/runtimes/quickapp/src/jse/modules/Make.defs
-include $(APPDIR)/frameworks/runtimes/quickapp/src/framework/dom-protobuf/Make.defs

-include $(APPDIR)/frameworks/runtimes/quickapp/src/features/Make.defs

endif
